{
  "name": "tsudoku",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=@tsudoku/server\" \"npm run dev --workspace=@tsudoku/client\"",
    "build": "npm run build --workspace=@tsudoku/shared && npm run build --workspace=@tsudoku/server && npm run build --workspace=@tsudoku/client",
    "start": "npm run start --workspace=@tsudoku/server"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "^5.6.3"
  }
}
